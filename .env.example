# Copy this file to .env and fill in real values. Never commit the real .env —
# it's gitignored on purpose (see .gitignore).

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
BROWSER=none
# From the app's Basic Information page in the monday Developer Center.
MONDAY_SIGNING_SECRET=
# Legacy fallback token for session-less webhooks — used only until an account has
# authorized via OAuth. Remove once all accounts are onboarded via OAuth.
MONDAY_API_TOKEN=

# ── Monday OAuth (per-account API access for the published app) ────────────────
# From your app's OAuth section in the Developer Center. Redirect URI must match
# exactly what you register there: <APP_URL>/oauth/callback
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
APP_URL=
# Optional explicit override; otherwise derived as <APP_URL>/oauth/callback
MONDAY_OAUTH_REDIRECT_URI=

# ── WhatsApp (Meta Cloud API) ─────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ── Monday board IDs ──────────────────────────────────────────────────────────
# Plain KEY=value only — no spaces around "=" and no trailing ";" (those become part
# of the value and break GraphQL queries like `boards(ids: 2028904077;)`).
PRODUCTS_BOARD_ID=
ORDER_BOARD_ID=
ORDER_ITEM_BOARD_ID=
SUPPLIER_BOARD_ID=
SUPPLIER_PRODUCT_BOARD_ID=
SUPPLIER_MANIFEST_BOARD_ID=
SHIPMENTS_BOARD_ID=
CUSTOMER_BOARD_ID=

# ── Shiprocket ────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
